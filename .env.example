# Python server only. Never copy service-role/OpenAI keys into Lovable/Vite vars.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-side ChatGPT planning via the OpenAI Responses API.
OPENAI_API_KEY=
OPENAI_MODEL=

# Lovable/TanStack server only. Fine-grained token needs Actions: write on the
# private factory repository. Never prefix these with VITE_.
FACTORY_GITHUB_TOKEN=
FACTORY_GITHUB_REPOSITORY=your-org/native-build-studio
FACTORY_GITHUB_REF=main
